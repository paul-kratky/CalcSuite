#include <winresrc.h>

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "calcsuite-driver.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,3,0
 PRODUCTVERSION 1,0,3,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "CalcSuite"
      VALUE "FileDescription", "CalcSuite USB driver helper (libwdi)"
      VALUE "FileVersion", "1.0.3"
      VALUE "InternalName", "calcsuite-driver"
      VALUE "LegalCopyright", "LGPL-3.0-or-later; includes libwdi (LGPL-3.0-or-later)"
      VALUE "OriginalFilename", "calcsuite-driver.exe"
      VALUE "ProductName", "CalcSuite"
      VALUE "ProductVersion", "1.0.3"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
